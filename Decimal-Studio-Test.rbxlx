		<Item class="Script" referent="RBX194">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!nocheck
local RS=game:GetService("ReplicatedStorage")
local tests=RS:WaitForChild("DecimalStudioTests")
local Decimal=require(RS.Decimal)
tests.DecimalRoundTrip.OnServerEvent:Connect(function(player,payload)
 local incoming=Decimal.new(payload)
 assert(incoming:eq("1e1000"), "Decimal network payload corrupted")
 tests.DecimalRoundTrip:FireClient(player, incoming:add("2e1000"):toJSON())
 print("[DECIMAL_STUDIO_NETWORK] Server decoded client payload and replied 3e+1000")
end)
tests.ClientReport.OnServerEvent:Connect(function(player,report)
 tests:SetAttribute("ClientStatus", report.failed==0 and "PASS" or "FAIL")
 tests:SetAttribute("ClientPassed", report.passed)
 tests:SetAttribute("ClientIntegration", report.integration)
 print("[DECIMAL_STUDIO_CLIENT_RECEIPT] " .. game:GetService("HttpService"):JSONEncode(report))
end)
local ok,result=pcall(function() return require(tests.Harness)("Server") end)
tests:SetAttribute("ServerStatus",ok and "PASS" or "FAIL")
if ok then
 tests:SetAttribute("ServerPassed",result.passed)
 tests:SetAttribute("ServerIntegration",result.integration)
else warn("[DECIMAL_STUDIO_FAILURE] Server "..tostring(result)) end
]]></ProtectedString>
