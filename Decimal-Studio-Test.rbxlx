			</Properties>
			<Item class="LocalScript" referent="RBX197">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!nocheck
local RS=game:GetService("ReplicatedStorage")
local tests=RS:WaitForChild("DecimalStudioTests")
local Decimal=require(RS:WaitForChild("Decimal"))
local gui=Instance.new("ScreenGui")
gui.Name="DecimalTestResults"
gui.IgnoreGuiInset=true
gui.ResetOnSpawn=false
gui.Parent=game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local label=Instance.new("TextLabel")
label.Size=UDim2.new(1,0,1,0)
label.BackgroundColor3=Color3.fromRGB(18,24,34)
label.TextColor3=Color3.fromRGB(225,240,235)
label.Font=Enum.Font.Code
label.TextSize=24
label.TextWrapped=true
label.Text="Decimal: running server and client tests..."
label.Parent=gui
local clientDone=false
local clientCount=0
local clientIntegration=0
local function render()
  local serverStatus=tests:GetAttribute("ServerStatus") or "RUNNING"
  label.Text="BREAK INFINITY / ROBLOX STUDIO"..string.char(10,10).."Server: "..serverStatus.." / "..tostring(tests:GetAttribute("ServerPassed") or 0).." checks"..string.char(10).."Client: "..(clientDone and "PASS" or "RUNNING").." / "..tostring(clientCount).." checks"..string.char(10,10).."Roblox JSON and module loading: "..tostring(tests:GetAttribute("ServerIntegration") or 0).." server / "..clientIntegration.." client checks"..string.char(10).."Network round trip: "..(clientDone and "PASS" or "WAITING")..string.char(10,10).."Engine "..version()
end
task.spawn(function()
 repeat
  render()
  task.wait(.25)
 until clientDone and tests:GetAttribute("ServerStatus")~=nil
 render()
end)
local networkAck=false
local connection=tests.DecimalRoundTrip.OnClientEvent:Connect(function(payload)
 assert(Decimal.new(payload):eq("3e1000"), "Decimal network reply corrupted")
 networkAck=true
 print("[DECIMAL_STUDIO_NETWORK] Client received and decoded 3e+1000")
end)
local ok,result=pcall(function() return require(tests.Harness)("Client") end)
if ok then
 tests.DecimalRoundTrip:FireServer(Decimal.new("1e1000"):toJSON())
 local deadline=os.clock()+15
 while not networkAck and os.clock()<deadline do task.wait() end
 assert(networkAck, "Decimal network round trip timed out")
 result.integration+=1
 clientDone=true;clientCount=result.passed;clientIntegration=result.integration
 tests.ClientReport:FireServer(result)
 print("[DECIMAL_STUDIO_CLIENT_COMPLETE] passed="..result.passed.." integration="..result.integration.." failed=0")
else
 warn("[DECIMAL_STUDIO_FAILURE] Client "..tostring(result))
 tests.ClientReport:FireServer({failed=1,passed=0,integration=0,error=tostring(result)})
end
connection:Disconnect()
]]></ProtectedString>
