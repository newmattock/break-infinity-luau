			<Item class="ModuleScript" referent="RBX190">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nocheck
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Decimal = require(script.Parent.Parent.Decimal)
return function(environment)
 local started = os.clock()
 local total = require(script.Parent.Unit)()
 local integration = 0
 local function expect(value, label)
  assert(value, "Roblox integration: " .. label)
  integration += 1
 end
 for _, text in {"0", "1e1000", "-6e900", "1.23456789e-999", "1e9000000000000000"} do
  local before = Decimal.new(text)
  local encoded = HttpService:JSONEncode({value=before:toJSON()})
  local after = Decimal.new(HttpService:JSONDecode(encoded).value)
  expect(before:eq(after), "JSON round trip " .. text)
 end
 expect(typeof(Decimal.new(1)) == "table", "Roblox table type")
 expect(RunService:IsStudio(), "Studio engine runtime")
 expect(environment == (RunService:IsServer() and "Server" or "Client"), "execution context")
 local cachedA = require(script.Parent.Parent.Decimal)
 expect(rawequal(cachedA, Decimal), "ModuleScript cache")
 local checker = require(script.Parent.CheckReference)
 local emptyAPI = {instance={}, static={}}
 for _, suite in {{"RepositoryReference","RepositoryAPI"},{"PublishedReference","PublishedAPI"}} do
  local chunks = script.Parent[suite[1]]:GetChildren()
  table.sort(chunks, function(a,b) return a.Name < b.Name end)
  local subtotal = 0
  for _, chunk in chunks do
   local result = checker(require(chunk), emptyAPI)
   subtotal += result.passed
   task.wait()
  end
  subtotal += checker({}, require(script.Parent[suite[2]])).passed
  total += subtotal
  print("[DECIMAL_STUDIO] " .. environment .. " " .. suite[1] .. " passed=" .. subtotal .. " failed=0")
 end
 local result = {environment=environment, passed=total, integration=integration, failed=0, seconds=os.clock()-started, engine=version()}
 print("[DECIMAL_STUDIO_RESULT] " .. HttpService:JSONEncode(result))
 return result
end
]]></ProtectedString>
