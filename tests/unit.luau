--!strict
local Decimal = require("../Decimal")
local count = 0
local function check(condition: boolean, label: string)
	count += 1
	assert(condition, label)
end
local function eq(value: Decimal.Decimal, expected: Decimal.DecimalSource, label: string)
	check(value:eq(expected), label .. ": " .. value:toString())
end
local a: Decimal.Decimal = Decimal.new("1e1000")
local b = Decimal("2e1000")
eq(a + b, "3e1000", "addition operator")
eq(b - a, "1e1000", "subtraction operator")
eq(a * 3, "3e1000", "number on right")
eq(3 * a, "3e1000", "number on left")
eq(a / 2, "5e999", "division operator")
eq(2 / Decimal.new("1e1000"), "2e-1000", "division with number on left")
eq(Decimal.new(10) ^ 400, "1e400", "power operator")
eq(-a, "-1e1000", "unary minus")
check(a < b and a <= b and b > a and b >= a, "comparison operators")
check(a == a:clone(), "value equality operator")
check(a ~= b, "value inequality operator")
check(tostring(a) == "1e+1000", "tostring metamethod")
check(Decimal.fromValue_noAlloc(a) == a, "no-allocation conversion")
check(not rawequal(Decimal.new(a), a), "constructor copies")
check(not rawequal(a:clone(), a), "clone copies")
local m = Decimal.new(60)
m.m = 4; m.e = 99
eq(m, "4e99", "field aliases write through")
check(m.mantissa == 4 and m.exponent == 99, "canonical fields read aliases")
m.s = -1; eq(m, "-4e99", "sign setter")
m.s = 0; eq(m, 0, "zero sign resets exponent")
m:setMantissaExponent(6000, 10); eq(m, "6e13", "normalized setter")
m:setMantissaExponent_noNormalize(6000, 10)
check(m.m == 6000 and m.e == 10, "raw setter")
m:normalize(); eq(m, "6e13", "normalize")
m:setFromNumber(116); eq(m, 116, "number setter")
m:setFromNumber_bypassCache(-116); eq(m, -116, "uncached number setter")
check(rawequal(m:setFromString("6e1000"), m), "string setter returns self")
m:setFromString_bypassCache("1e-1000"); eq(m, "1e-1000", "uncached string setter")
m:copyFrom({mantissa=7,exponent=999}); eq(m, "7e999", "copyFrom interface")
eq(m:fromMantissaExponent(30,100):fromNumber(5):fromString("6e1000"), "6e1000", "legacy fluent helpers")
eq(m:fromDecimal(a), a, "legacy fromDecimal")
eq(m:fromValue(nil), 0, "legacy nil value")
eq(Decimal.fromDecimal(a), a, "legacy static copy")
eq(Decimal.fromValue("1e1000"), a, "legacy static fromValue")
check(Decimal.new() ~= a and Decimal.new():eq(0), "empty constructor")
check(Decimal.new({mantissa=60,exponent=8}).m == 60, "constructor preserves interface fields")
eq(Decimal.fromValue_noAlloc({mantissa=60,exponent=8}), "6e9", "conversion normalizes interface")
for _, field in {"ZERO","ONE","MINUS_ONE","MAX_VALUE","MIN_VALUE","NUMBER_MAX_VALUE","NUMBER_MIN_VALUE","NaN","POSITIVE_INFINITY","NEGATIVE_INFINITY"} do
	local constant = (Decimal :: any)[field]
	check(table.isfrozen(constant), "frozen " .. field)
	check(not pcall(function() constant.m = 9 end), "alias protects " .. field)
	check(not pcall(function() constant.mantissa = 9 end), "field protects " .. field)
end
check(rawequal(Decimal.const("1e999"), Decimal.constant("1e999")), "constant cache identity")
local cached = Decimal.const(123)
check(rawequal(Decimal.fromNumber(123), cached), "cached number conversion")
check(not rawequal(Decimal.fromNumber_bypassCache(123), cached), "cache bypass allocates")
local copy = Decimal.new(cached); copy.m = 8
check(cached.m ~= copy.m, "constructor copy of constant is mutable")
check(Decimal.const(0/0):isNaN(), "NaN constant key")
check(table.isfrozen(Decimal), "module frozen")
check(not pcall(function() (Decimal :: any).ZERO = m end), "constant cannot be replaced")
check(Decimal.new(0):recip():isNaN(), "upstream reciprocal zero behavior")
eq(Decimal.new(0):pow(0), 0, "upstream zero power behavior")
check(Decimal.NaN:cmp(Decimal.NaN) == 0, "upstream NaN total ordering")
check(not Decimal.NaN:eq(Decimal.NaN), "NaN method equality")
check(Decimal.NaN:lte(1) and not Decimal.NaN:lessThanOrEqualTo(1), "upstream comparison aliases differ for NaN")
check(not pcall(function() Decimal.new("Infinity") end), "upstream lowercased infinity string is invalid")
check(Decimal.new(math.huge):isPositiveInfinity(), "numeric infinity")
check(Decimal.new(-math.huge):isNegativeInfinity(), "numeric negative infinity")
check(Decimal.new("NaN"):isNaN(), "NaN string")
check(Decimal.new(5e-324):toNumber() == 5e-324, "minimum double")
check(Decimal.new(-5e-324):toNumber() == -5e-324, "negative minimum double")
check(Decimal.new("1e-1000"):toNumber() == 0, "numeric underflow")
check(Decimal.new("1e1000"):toNumber() == math.huge, "numeric overflow")
check(Decimal.new("1e-9000000000000000"):toString() == "0", "lower display limit")
check(Decimal.new(1.25):toFixed(1) == "1.3", "decimal tie formatting")
check(Decimal.new(-1.25):toFixed(1) == "-1.3", "negative decimal tie formatting")
check(Decimal.new(2.55):toFixed(1) == "2.5", "binary64 rounding")
check(Decimal.new(1):toFixed(100) == "1." .. string.rep("0",100), "100 fractional digits")
check(Decimal.new("1e9000000000000000"):toExponential(2) == "1.00e+9000000000000000", "huge exponent formatting")
check(not pcall(function() Decimal.MAX_VALUE:toFixed(2) end), "bounded output allocation")
check(not pcall(function() Decimal.ZERO:toFixed(math.huge) end), "infinite precision rejected")
check(not pcall(function() Decimal.new(true :: any) end), "invalid source rejected")
check(not pcall(function() Decimal.new("invalid") end), "invalid string rejected")
-- Buffer transport preserves input bits on hosts whose parser flushes subnormal literals.
local tinyBuffer = buffer.create(8)
buffer.writeu32(tinyBuffer, 0, 1)
local tiny = buffer.readf64(tinyBuffer, 0)
eq(Decimal.new(tiny), "5e-324", "raw minimum double constructor")
eq(Decimal.NUMBER_MIN_VALUE, "5e-324", "minimum-double constant is not zero")
eq(Decimal.new(tiny):mul(3), "1.5e-323", "raw subnormal numeric multiplier")
eq(Decimal.fromMantissaExponent(tiny, 900), "5e576", "raw subnormal mantissa normalization")
local convertedTiny = Decimal.new("5e-324"):toNumber()
buffer.writef64(tinyBuffer, 0, convertedTiny)
check(buffer.readu32(tinyBuffer, 0) == 1 and buffer.readu32(tinyBuffer, 4) == 0, "toNumber preserves subnormal bits")
check(Decimal.new(-10):pow(Decimal.new("5e-324")):isNaN(), "negative base with subnormal fractional exponent")
eq(Decimal.exp(-745), "5e-324", "rounded subnormal power")
local rngValues = 0
for _ = 1, 200 do
	local r = Decimal.randomDecimalForTesting(1000)
	check(r:isFinite() and math.abs(r.e) <= 1001, "random helper range")
	check(r.m == 0 or math.abs(r.m) >= 0.99999999999999 and math.abs(r.m) < 10.00000000000001, "random helper normalized")
	if r.m ~= 0 then rngValues += 1 end
end
check(rngValues > 100, "random helper produces nonzero values")
-- Purchase helpers verify useful finite cases separately from reference equality.
eq(Decimal.sumGeometricSeries(3,10,2,0), 70, "geometric price sum")
eq(Decimal.affordGeometricSeries(70,10,2,0), 3, "geometric affordability")
eq(Decimal.sumArithmeticSeries(3,10,5,0), 45, "arithmetic price sum")
eq(Decimal.affordArithmeticSeries(45,10,5,0), 3, "arithmetic affordability")
eq(Decimal.efficiencyOfPurchase(100,10,5), 30, "purchase efficiency")
print("Luau unit:", count, "passed")
